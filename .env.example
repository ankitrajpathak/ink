# Runs without keys. Never put secrets in NEXT_PUBLIC variables.
# Required before any paid/live adapters activate. Enter this in Settings.
INK_ACCESS_KEY=
# OpenAI-compatible chat completions endpoint. Default provider: OpenAI.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Brave Search API for company discovery and article evidence.
BRAVE_SEARCH_API_KEY=
# Optional trusted JSON adapter gateways. See docs/ADAPTERS.md.
COMPANY_ADAPTER_URL=
COMPANY_ADAPTER_TOKEN=
SEARCH_ANALYTICS_ADAPTER_URL=
SEARCH_ANALYTICS_ADAPTER_TOKEN=
